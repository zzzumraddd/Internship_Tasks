{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "nginx-logs",
      "folder": "Logs",
      "interval": "1m",
      "rules": [
        {
          "uid": "nginx-5xx-ratio",
          "title": "Nginx 5xx ratio above 5%",
          "condition": "C",
          "for": "2m",
          "noDataState": "OK",
          "execErrState": "Error",
          "isPaused": false,
          "labels": {
            "service": "nginx",
            "severity": "warning"
          },
          "annotations": {
            "summary": "Nginx 5xx ratio exceeds 5%",
            "description": "More than 5% of nginx access logs were 5xx during the last 5 minutes, for 2 minutes.",
            "__dashboardUid__": "logs-overview",
            "__panelId__": "1"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "loki",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "loki",
                  "uid": "loki"
                },
                "expr": "100 * (sum(count_over_time({job=\"nginx\",status=~\"5..\"}[5m])) or vector(0)) / sum(count_over_time({job=\"nginx\",status=~\"[1-5][0-9][0-9]\"}[5m]))",
                "queryType": "instant",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        5
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "policies": [
    {
      "orgId": 1,
      "receiver": "grafana-default-email",
      "group_by": [
        "grafana_folder",
        "alertname"
      ],
      "routes": [
        {
          "receiver": "telegram",
          "object_matchers": [
            [
              "service",
              "=",
              "nginx"
            ]
          ],
          "group_wait": "30s",
          "group_interval": "5m",
          "repeat_interval": "4h"
        }
      ]
    }
  ]
}
